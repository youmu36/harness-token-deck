  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:contracts": "node scripts/gen_contracts.mjs",
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json",
